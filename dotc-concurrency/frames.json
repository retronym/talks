  "file": "Basket.scala",
  "code": [
   "import tests.macros.Latch",
   "",
   "case class Item(name: String, price: BigDecimal, qty: Int)",
   "",
   "object Basket:",
   "  val items = List(Item(\"tea\", 4.5, 2), Item(\"milk\", 1.2, 1))",
   "",
   "  def subtotal =",
   "    val hold = Latch.await",
   "    items.map(i => i.price * i.qty).sum + hold",
   "",
   "  def tax = subtotal * 0.2",
   "",
   "object Checkout:",
   "  import Basket.*",
   "",
   "  def total = subtotal + tax",
   "",
   "  def receipt: String =",
   "    val lines = items.map(i => s\"${i.name} x${i.qty}\")",
   "    lines.mkString(\"\\n\") + s\"\\ntotal $total\""

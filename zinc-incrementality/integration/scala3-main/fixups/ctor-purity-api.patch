diff --git a/compiler/src/dotty/tools/dotc/sbt/ExtractAPI.scala b/compiler/src/dotty/tools/dotc/sbt/ExtractAPI.scala
index b6b657789c..01ac9ad1d2 100644
--- a/compiler/src/dotty/tools/dotc/sbt/ExtractAPI.scala
+++ b/compiler/src/dotty/tools/dotc/sbt/ExtractAPI.scala
@@ -259,6 +259,30 @@ private class ExtractAPICollector(nonLocalClassSymbols: mutable.HashSet[Symbol])
   private val matchMarker = marker("Match")
   private val superMarker = marker("Super")
 
+  /** Marks the primary constructor of a class whose instantiation has no side
+   *  effects, see `hasPureInit`.
+   */
+  private val pureInitMarker = marker("<pure-init>")
+
+  /** Can creating an instance of `cls` be elided when the instance is unused?
+   *
+   *  Clients compile against this: `TreeInfo.isPureApply` treats `new C` as pure if
+   *  the primary constructor of `C` is `StableRealizable`, and `refPurity` treats a
+   *  reference to object `O` as pure if `O`'s module class is `isNoInitsRealClass`.
+   *  Pure expressions are elided (e.g. an argument to an unused parameter of an inline method) or
+   *  warned about in statement position. Both facts hold iff no base class has
+   *  initialization code, which can change without any change to the signatures of
+   *  `C` or its ancestors (adding a statement or a private val to a template), so we
+   *  add a marker to the primary constructor to make the change visible to Zinc.
+   *
+   *  For a trait, `StableRealizable` only reflects the trait's own body, but an
+   *  anonymous class `new T {}` is pure iff all base classes of `T` are `NoInits`,
+   *  so we use that for traits.
+   */
+  private def hasPureInit(cls: Symbol): Boolean =
+    if cls.is(Trait) then cls.asClass.baseClasses.forall(_.is(NoInits))
+    else cls.primaryConstructor.is(StableRealizable)
+
   /** Extract the API representation of a source file */
   def apiSource(tree: Tree): Seq[api.ClassLike] = {
     def apiClasses(tree: Tree): Unit = tree match {
@@ -350,10 +374,10 @@ private class ExtractAPICollector(nonLocalClassSymbols: mutable.HashSet[Symbol])
 
     val apiBases = bases.map(apiType)
 
-    // Synthetic methods that are always present do not affect the API
-    // and can therefore be ignored.
-    def alwaysPresent(s: Symbol) = csym.is(ModuleClass) && s.isConstructor
-    val decls = cinfo.decls.filter(!alwaysPresent(_))
+    // The constructor of an object carries the `pureInitMarker`, so keep it.
+    // (It used to be filtered out here, but came back among the inherited
+    // members below, as `baseClasses` includes `csym` itself.)
+    val decls = cinfo.decls.toList
     val apiDecls = apiDefinitions(decls)
 
     val declSet = decls.toSet
@@ -741,6 +765,9 @@ private class ExtractAPICollector(nonLocalClassSymbols: mutable.HashSet[Symbol])
 
     end if
 
+    if s.isConstructor && s == s.owner.primaryConstructor && hasPureInit(s.owner) then
+      annots += pureInitMarker
+
     // In the Scala2 ExtractAPI phase we only extract annotations that extend
     // StaticAnnotation, but in Dotty we currently pickle all annotations so we
     // extract everything, except:
diff --git a/compiler/src/dotty/tools/dotc/sbt/ExtractDependencies.scala b/compiler/src/dotty/tools/dotc/sbt/ExtractDependencies.scala
index 6bfd406a6d..503bd5c96a 100644
--- a/compiler/src/dotty/tools/dotc/sbt/ExtractDependencies.scala
+++ b/compiler/src/dotty/tools/dotc/sbt/ExtractDependencies.scala
@@ -178,6 +178,7 @@ trait AbstractExtractDependenciesCollector(rec: DependencyRecorder) extends tpd.
         assert(enclOrModuleClass.isClass, s"$enclOrModuleClass, $sym")
 
         rec.addClassDependency(enclOrModuleClass, DependencyByMemberRef)
+        addPureInitDependency(sym)
       }
     }
 
@@ -200,6 +201,22 @@ trait AbstractExtractDependenciesCollector(rec: DependencyRecorder) extends tpd.
     if pkg.is(Package) && !pkg.isEffectiveRoot then
       rec.addUsedRawName(ExtractDependencies.packageWildcardName(pkg))
 
+  /** Whether a reference to `sym` is pure can depend on whether a class has
+   *  initialization code: an object (`TreeInfo.refPurity`) or the companion of a
+   *  synthetic case class `apply` (`TreeInfo.isPureSyntheticCaseApply`).
+   *  `ExtractAPI` marks the primary constructor of such classes when they have no
+   *  initialization code (see `ExtractAPICollector#hasPureInit`), so record the
+   *  name of that constructor. An instantiation `new C` already uses it.
+   */
+  private def addPureInitDependency(sym: Symbol)(using Context): Unit =
+    val cls =
+      if sym.is(ModuleVal) then sym.moduleClass
+      else if sym.isAllOf(SyntheticMethod) && sym.name == nme.apply && sym.owner.is(ModuleClass) then
+        sym.owner.companionClass.filter(_.is(Case))
+      else NoSymbol
+    if cls.isClass && !cls.is(JavaDefined) && cls.primaryConstructor.exists then
+      rec.addUsedName(cls.primaryConstructor)
+
   private def addInheritanceDependencies(tree: Closure)(using Context): Unit =
     // If the tpt is empty, this is a non-SAM lambda, so no need to register
     // an inheritance relationship.
diff --git a/sbt-bridge/test/xsbt/ExtractAPISpecification.scala b/sbt-bridge/test/xsbt/ExtractAPISpecification.scala
index ccc59a78ff..d93ccb1251 100644
--- a/sbt-bridge/test/xsbt/ExtractAPISpecification.scala
+++ b/sbt-bridge/test/xsbt/ExtractAPISpecification.scala
@@ -345,4 +345,56 @@ class ExtractAPISpecification {
          |A.runSub 1562250696""".stripMargin
     assertEquals(expected, markers.mkString("\n"))
   }
+
+  /** The name hash Zinc computes for the constructor of `cls`, if it is part of the API. */
+  private def ctorNameHash(src: String, cls: String, defType: DefinitionType): Option[Int] = {
+    val compilerForTesting = new ScalaCompilerForUnitTesting
+    val api = compilerForTesting.extractApiFromSrc(src).find(c => c.name == cls && c.definitionType == defType).get
+    val ctorName = if (defType == DefinitionType.Module) s"$cls$$;init;" else s"$cls;init;"
+    new xsbt.api.NameHashing(false).nameHashes(api).find(_.name == ctorName).map(_.hash)
+  }
+
+  /** Clients elide `new B` and references to `O` if they have no initialization
+   *  code, direct or inherited. Changes to that status must change the API of
+   *  the constructor even when no signature changes.
+   */
+  @Test
+  def constructorPurityIsPartOfTheApi = {
+    def src(t: String, a: String) =
+      s"""|trait T { $t }
+          |class A extends T { $a }
+          |class B extends A
+          |object O extends A
+          |""".stripMargin
+    val base = src("def t = 1", "def a = 1")
+    val unrelated = List(
+      src("def t = 2", "def a = 1"),
+      src("def t = 1", "def a = 2; def b = 3"),
+      src("def t = 1", "def a = 1; private def c = 3"),
+    )
+    val impure = List(
+      src("def t = 1", "def a = 1; println()"),
+      src("def t = 1", "def a = 1; private val x = 1"),
+      src("val t = 1", "def a = 1"),
+    )
+    for ((cls, defType) <- List("B" -> DefinitionType.ClassDef, "O" -> DefinitionType.Module)) {
+      val before = ctorNameHash(base, cls, defType)
+      assertTrue(s"$cls has a pure constructor", before.isDefined)
+      for (v <- unrelated)
+        assertEquals(s"$cls\n$v", before, ctorNameHash(v, cls, defType))
+      for (v <- impure)
+        assertNotEquals(s"$cls\n$v", before, ctorNameHash(v, cls, defType))
+    }
+  }
+
+  /** A trait is not instantiated itself, but `new T {}` is pure iff all its base
+   *  classes are free of initialization code.
+   */
+  @Test
+  def traitConstructorPurityIncludesAncestors = {
+    def src(u: String) = s"trait U { $u }\ntrait T extends U\n"
+    val before = ctorNameHash(src("def u = 1"), "T", DefinitionType.Trait)
+    assertEquals(before, ctorNameHash(src("def u = 2"), "T", DefinitionType.Trait))
+    assertNotEquals(before, ctorNameHash(src("val u = 1"), "T", DefinitionType.Trait))
+  }
 }

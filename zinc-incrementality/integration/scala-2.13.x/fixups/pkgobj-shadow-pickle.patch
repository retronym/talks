 .../tools/nsc/backend/jvm/BCodeHelpers.scala  |  3 +-
 .../tools/nsc/symtab/classfile/Pickler.scala  | 16 +++++++-
 ...ckage-object-shadows-toplevel-pickle.scala | 40 +++++++++++++++++++
 3 files changed, 57 insertions(+), 2 deletions(-)
 create mode 100644 test/files/run/package-object-shadows-toplevel-pickle.scala

diff --git a/src/compiler/scala/tools/nsc/backend/jvm/BCodeHelpers.scala b/src/compiler/scala/tools/nsc/backend/jvm/BCodeHelpers.scala
index eecbe0dc51..2cae3f8c20 100644
--- a/src/compiler/scala/tools/nsc/backend/jvm/BCodeHelpers.scala
+++ b/src/compiler/scala/tools/nsc/backend/jvm/BCodeHelpers.scala
@@ -933,7 +933,8 @@ abstract class BCodeHelpers extends BCodeIdiomatic {
       if (emitSource)
         mirrorClass.visitSource("" + cunit.source, null /* SourceDebugExtension */)
 
-      val ssa = getAnnotPickle(bType.internalName, moduleClass.companionSymbol)
+      // Not `companionSymbol`, which looks in the package's scope; see `PicklePhase.apply`.
+      val ssa = getAnnotPickle(bType.internalName, moduleClass.sourceModule)
       mirrorClass.visitAttribute(if (ssa.isDefined) pickleMarkerLocal else pickleMarkerForeign)
       emitAnnotations(mirrorClass, moduleClass.annotations ++ ssa)
 
diff --git a/src/compiler/scala/tools/nsc/symtab/classfile/Pickler.scala b/src/compiler/scala/tools/nsc/symtab/classfile/Pickler.scala
index 79556be4ba..ab969f44ac 100644
--- a/src/compiler/scala/tools/nsc/symtab/classfile/Pickler.scala
+++ b/src/compiler/scala/tools/nsc/symtab/classfile/Pickler.scala
@@ -70,6 +70,20 @@ abstract class Pickler extends SubComponent {
 
     @nowarn("cat=lint-nonlocal-return")
     def apply(unit: CompilationUnit): Unit = {
+      // Find companions among the unit's top-level definitions rather than with `companionSymbol`, which looks
+      // in the package's scope. `openPackageModule` unlinks a top-level definition from that scope if the package
+      // object defines or inherits a member of the same name, and the pickle of its companion would omit it.
+      val topLevelDefs: List[Symbol] = {
+        def collect(tree: Tree): List[Symbol] = tree match {
+          case PackageDef(_, stats)                      => stats.flatMap(collect)
+          case ClassDef(_, _, _, _) | ModuleDef(_, _, _) => tree.symbol :: Nil
+          case _                                         => Nil
+        }
+        collect(unit.body)
+      }
+      def companionOf(sym: Symbol): Symbol =
+        topLevelDefs.find(other => other.owner == sym.owner && other.isModule != sym.isModule && other.name.toTermName == sym.name.toTermName).getOrElse(NoSymbol)
+
       def pickle(tree: Tree): Unit = {
         tree match {
           case PackageDef(_, stats) =>
@@ -79,7 +93,7 @@ abstract class Pickler extends SubComponent {
             def shouldPickle(sym: Symbol) = currentRun.compiles(sym) && !currentRun.symData.contains(sym)
             if (shouldPickle(sym)) {
               def pickle(noPrivates: Boolean, writeToSymData: Boolean, writeToSigFile: Boolean): Unit = {
-                val companion = sym.companionSymbol.filter(_.owner == sym.owner).filter(shouldPickle) // exclude companionship between package- and package object-owned symbols.
+                val companion = companionOf(sym).filter(shouldPickle)
                 val pickle = Pickler.this.pickle(sym, companion, noPrivates)
                 if (writeToSymData) {
                   currentRun.symData(sym) = pickle
diff --git a/test/files/run/package-object-shadows-toplevel-pickle.scala b/test/files/run/package-object-shadows-toplevel-pickle.scala
new file mode 100644
index 0000000000..e4ae56e36f
--- /dev/null
+++ b/test/files/run/package-object-shadows-toplevel-pickle.scala
@@ -0,0 +1,40 @@
+import scala.tools.partest._
+import java.io.File
+
+// A top-level definition whose name the package object also defines (or inherits) is shadowed by
+// the package object's member, but its classfiles must still carry its pickle: once that member is
+// removed, a separate compilation must see the top-level definition.
+object Test extends StoreReporterDirectTest {
+  class V1 {
+    def PT  = "package a; trait PT { object Foo; object Bar; def Baz = 0 }"
+    def pkg = "package a; package object b extends a.PT { object Qux }"
+    def Foo = "package a.b; object Foo { def x = 1 }"
+    def Bar = "package a.b; class Bar; object Bar { def y = 2 }"
+    def Baz = "package a.b; object Baz { def z = 3 }"
+    def Qux = "package a.b; object Qux { def w = 4 }"
+  }
+  class V2 extends V1 {
+    override def PT  = "package a; trait PT"
+    override def pkg = "package a; package object b extends a.PT"
+  }
+  def client = "package a.b; object Client { Foo.x; new Bar; Bar.y; Baz.z; Qux.w }"
+
+  override def extraSettings = s"-cp ${sys.props("partest.lib")}${File.pathSeparator}$testOutput"
+
+  def show(): Unit = {
+    val v1 = new V1
+    val v2 = new V2
+    compiles(v1.PT, v1.pkg, v1.Foo, v1.Bar, v1.Baz, v1.Qux)
+    compiles(v2.PT, v2.pkg)
+    compiles(client)
+  }
+
+  def compiles(codes: String*) = {
+    val global = newCompiler()
+    withRun(global)(_ compileSources newSources(codes: _*))
+    val reporterOutput = storeReporter.infos.map(x => x.pos.showError(x.msg)).mkString("\n")
+    assert(!global.reporter.hasErrors, reporterOutput)
+  }
+
+  def code = ""
+}

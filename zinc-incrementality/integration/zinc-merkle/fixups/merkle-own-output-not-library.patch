From 768771b18b0b2c0e4472e124777d5a28284efeca Mon Sep 17 00:00:00 2001
From: Jason Zaugg <jzaugg@gmail.com>
Date: Tue, 20 Oct 2026 03:28:18 +1000
Subject: [PATCH] Merkle: don't take this subproject's output for a library

Matching Scala 3's names for classes nested in objects made the binary
name candidates start from the Scala 2 form, so they no longer held the
name as stored, `p.L$.A`, which is how this subproject's classes are
keyed. In a clean build nothing else knew such a class: its binary name
is recorded by no previous analysis yet. So the classpath lookup found
its classfile in the output directory, already written, and took that
for the library defining it, and the directory's stamp went into the
hashes of every name its descendants inherit. The next incremental
compile knew the class and folded in nothing, so every inherited name
of every recompiled class with such an ancestor changed. On pekko under
Scala 3, adding an implicit to Timeout recompiled 869 sources in 6
cycles instead of 156 in 3.

The candidates keep the name as stored first again, and a class found
in this compile's own output is never a library, whatever name it was
looked up by: that also covers an ancestor named in the Scala 2 form
whose class is keyed in the Scala 3 one.

LibraryAncestorsSpec pins the candidates. The pekko replay (IncBench,
integration/scala3-merkle, timeout-add-implicit) recompiles 156 sources
in 3 cycles again, as under name hashing, and no ancestor resolves to
the output directory.
---
 .../scala/sbt/internal/inc/Incremental.scala  | 17 +++++++++++++-
 .../sbt/internal/inc/LibraryAncestors.scala   |  8 +++++--
 .../internal/inc/LibraryAncestorsSpec.scala   | 22 +++++++++++++++++++
 3 files changed, 44 insertions(+), 3 deletions(-)
 create mode 100644 internal/zinc-core/src/test/scala/sbt/internal/inc/LibraryAncestorsSpec.scala

diff --git a/internal/zinc-core/src/main/scala/sbt/internal/inc/Incremental.scala b/internal/zinc-core/src/main/scala/sbt/internal/inc/Incremental.scala
index 2c9a5f330..9dd818b9c 100644
--- a/internal/zinc-core/src/main/scala/sbt/internal/inc/Incremental.scala
+++ b/internal/zinc-core/src/main/scala/sbt/internal/inc/Incremental.scala
@@ -1491,10 +1491,25 @@ private final class AnalysisCallback(
             internalBinaryToSourceClassName(n).isDefined || isSubprojectClass(n)
         )
         if internal then None
-        else candidates.iterator.flatMap(lookup.lookupOnClasspath(_)).nextOption()
+        else
+          candidates.iterator
+            .flatMap(lookup.lookupOnClasspath(_))
+            .nextOption()
+            .filterNot(f => ownOutputs(converter.toPath(f).toAbsolutePath.normalize))
       }
     )
 
+  /**
+   * This compile's own outputs, which the classpath holds too. A class found there is one of
+   * this subproject's, whatever name it was looked up by, and not a library: in a clean build
+   * nothing yet records its binary name, and its classfile is already written.
+   */
+  private lazy val ownOutputs: Set[Path] =
+    def paths(o: Output): List[Path] =
+      o.getSingleOutputAsPath.toScala.toList ++
+        o.getMultipleOutput.toScala.toList.flatMap(_.toList.map(_.getOutputDirectoryAsPath))
+    (paths(output) ++ earlyOutput.toList.flatMap(paths)).map(_.toAbsolutePath.normalize).toSet
+
   /** The stamps of the libraries defining a class's library ancestors. See [[LibraryAncestors]]. */
   private def libraryFingerprint(sides: List[ClassLike]): Option[Int] =
     if !LibraryAncestors.invalidates(options) then None
diff --git a/internal/zinc-core/src/main/scala/sbt/internal/inc/LibraryAncestors.scala b/internal/zinc-core/src/main/scala/sbt/internal/inc/LibraryAncestors.scala
index e4b42620a..c8cf29ded 100644
--- a/internal/zinc-core/src/main/scala/sbt/internal/inc/LibraryAncestors.scala
+++ b/internal/zinc-core/src/main/scala/sbt/internal/inc/LibraryAncestors.scala
@@ -122,10 +122,13 @@ private[inc] object LibraryAncestors:
    */
   def canonical(name: String): String = name.replace("$.", ".")
 
-  /** Binary names a class rendered as `name` may have: `a.b.C.D` is `a.b.C$D` if C is a class. */
+  /**
+   * The names a class rendered as `name` may have: the name itself, which is how this subproject's
+   * classes are keyed, then its binary names, `a.b.C.D` being `a.b.C$D` if C is a class.
+   */
   def binaryNameCandidates(name: String): List[String] =
     val c = canonical(name)
-    Iterator
+    val binary = Iterator
       .iterate(c)(n =>
         n.lastIndexOf('.') match
           case -1 => n
@@ -133,6 +136,7 @@ private[inc] object LibraryAncestors:
       )
       .take(c.count(_ == '.') + 1)
       .toList
+    if c == name then binary else name :: binary
 
   private def ancestorNames(c: AnalyzedClass): Iterator[String] = ancestorNames(sides(c)).iterator
 
diff --git a/internal/zinc-core/src/test/scala/sbt/internal/inc/LibraryAncestorsSpec.scala b/internal/zinc-core/src/test/scala/sbt/internal/inc/LibraryAncestorsSpec.scala
new file mode 100644
index 000000000..d70ef4e1a
--- /dev/null
+++ b/internal/zinc-core/src/test/scala/sbt/internal/inc/LibraryAncestorsSpec.scala
@@ -0,0 +1,22 @@
+/*
+ * Zinc - The incremental compiler for Scala.
+ * Copyright Scala Center, Lightbend, and Mark Harrah
+ *
+ * Licensed under Apache License 2.0
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * See the NOTICE file distributed with this work for
+ * additional information regarding copyright ownership.
+ */
+
+package sbt.internal.inc
+
+class LibraryAncestorsSpec extends UnitSpec:
+  "binaryNameCandidates" should "list a Scala 2 nested name's binary names" in:
+    LibraryAncestors.binaryNameCandidates("a.O.C") shouldBe List("a.O.C", "a.O$C", "a$O$C")
+
+  it should "keep a Scala 3 nested name as stored, then its binary names" in:
+    LibraryAncestors.binaryNameCandidates("a.O$.C") shouldBe List("a.O$.C", "a.O.C", "a.O$C", "a$O$C")
+
+  "canonical" should "name the members of objects as Scala 2 does" in:
+    LibraryAncestors.canonical("a.O$.P$.C") shouldBe "a.O.P.C"
-- 
2.56.0


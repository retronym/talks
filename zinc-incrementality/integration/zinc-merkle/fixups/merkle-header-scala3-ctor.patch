From dc7574eb8ba5ed4ebeb3cf98ac576ffc4ce2ea0c Mon Sep 17 00:00:00 2001
From: Jason Zaugg <jzaugg@gmail.com>
Date: Tue, 20 Oct 2026 09:06:39 +1000
Subject: [PATCH] Merkle: the header rule knows Scala 3's constructor names

The header rule recompiles every descendant of a class whose
constructor's API changed. It looked for the name `<init>`, which is
how Scala 2 names a constructor; Scala 3 names it after its class,
`p;C;init;`, so under Scala 3 the rule never fired. That mattered
little while only signatures were hashed, since a descendant's super
call is a member reference to the constructor. Scala 3 now folds into
the constructor's API whether a class has initialization code (scala3
"Make constructor purity part of the Zinc API"), and every descendant's
own constructor purity is derived from it: when a trait gains a private
val, its descendant traits must recompile too, or they keep a STABLE
constructor in their TASTy and a class mixing them in later elides its
construction.

Recognise the changed class's own constructor in either form.

Under Scala 3 with that compiler, merkle-trait-private-member-chain now
takes one more cycle: Main, which constructs C, recompiles because C's
constructor changed. Its `checkIterations 3` is the Scala 2 count.
scala3-ctor-purity passes under both hashing modes with
integration/scala3-merkle.
---
 .../scala/sbt/internal/inc/DescendantRules.scala   | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/internal/zinc-core/src/main/scala/sbt/internal/inc/DescendantRules.scala b/internal/zinc-core/src/main/scala/sbt/internal/inc/DescendantRules.scala
index f1e2b2c09..90fd49da4 100644
--- a/internal/zinc-core/src/main/scala/sbt/internal/inc/DescendantRules.scala
+++ b/internal/zinc-core/src/main/scala/sbt/internal/inc/DescendantRules.scala
@@ -267,11 +267,23 @@ private[inc] object DescendantRules:
   /** The descendant's own type check reads the changed class's header. */
   val header: DescendantRule = rule("header") { (_, _, change) =>
     if change.headerChanged then Some(s"header of ${change.className} changed")
-    else if change.modifiedNameStrings.contains("<init>") then
+    else if change.modifiedNameStrings.exists(isOwnConstructor(_, change.className)) then
       Some(s"constructor of ${change.className} changed")
     else None
   }
 
+  /**
+   * Whether `name` is the constructor of `className`: `<init>` under Scala 2, the class's name
+   * with `;` for `.` and `;init;` appended under Scala 3 (`p;O$;C;init;`). Scala 3 folds whether
+   * a class has initialization code into its constructor's API, which every descendant's
+   * constructor purity depends on.
+   */
+  private def isOwnConstructor(name: String, className: String): Boolean =
+    def normal(n: String) = LibraryAncestors.sourceName(LibraryAncestors.canonical(n))
+    name == "<init>" ||
+    name.endsWith(";init;") &&
+    normal(name.stripSuffix(";init;").replace(';', '.')) == normal(className)
+
   /** Classes mixing in a trait get forwarders for its concrete members. */
   val `trait`: DescendantRule = rule("trait") { (view, _, change) =>
     if view.isTrait(change.className) then Some(s"mixes in trait ${change.className}") else None
-- 

From d34f4046d2b88135f543d0e07bace67f58c208a7 Mon Sep 17 00:00:00 2001
From: Jason Zaugg <jzaugg@gmail.com>
Date: Tue, 20 Oct 2026 03:39:02 +1000
Subject: [PATCH] Test: a Scala 3 class nested in an object keeps its API
 across a clean build

merkle3-nested-ancestor-stable: `object L { abstract class A; final
case class B(x: Int) extends A }` and a client of L.B; a body edit to
L.scala must recompile L.scala alone. Before the previous change the
clean build took L.A's classfile in the output directory for a library,
the incremental one did not, so every name L.B inherits changed and the
client recompiled in a second cycle. Scala 3 only: its stored name for
L.A, `p.L$.A`, is not among the Scala 2 form's candidates.
---
 .../merkle3-nested-ancestor-stable/build.json            | 5 +++++
 .../merkle3-nested-ancestor-stable/changes/L.scala       | 5 +++++
 .../merkle3-nested-ancestor-stable/p/L.scala             | 5 +++++
 .../merkle3-nested-ancestor-stable/p/U.scala             | 4 ++++
 .../p/incOptions.properties                              | 3 +++
 .../merkle3-nested-ancestor-stable/test                  | 9 +++++++++
 6 files changed, 31 insertions(+)
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/build.json
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/changes/L.scala
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/L.scala
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/U.scala
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/incOptions.properties
 create mode 100644 zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/test

diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/build.json b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/build.json
new file mode 100644
index 000000000..f33b448fd
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/build.json
@@ -0,0 +1,5 @@
+{
+  "projects": [
+    {"name": "p", "scalaVersion": "3.x"}
+  ]
+}
diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/changes/L.scala b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/changes/L.scala
new file mode 100644
index 000000000..1581d37a0
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/changes/L.scala
@@ -0,0 +1,5 @@
+package p
+object L {
+  abstract class A { def a: Int = 2 }
+  final case class B(x: Int) extends A
+}
diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/L.scala b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/L.scala
new file mode 100644
index 000000000..4a0b1b4b4
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/L.scala
@@ -0,0 +1,5 @@
+package p
+object L {
+  abstract class A { def a: Int = 1 }
+  final case class B(x: Int) extends A
+}
diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/U.scala b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/U.scala
new file mode 100644
index 000000000..ba28f79fd
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/U.scala
@@ -0,0 +1,4 @@
+package p
+object U {
+  def u: Int = L.B(1).hashCode
+}
diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/incOptions.properties b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/incOptions.properties
new file mode 100644
index 000000000..38b4369ca
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/p/incOptions.properties
@@ -0,0 +1,3 @@
+hashing = merkle
+apiDebug = false
+pipelining = false
diff --git a/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/test b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/test
new file mode 100644
index 000000000..602d90a71
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/merkle3-nested-ancestor-stable/test
@@ -0,0 +1,9 @@
+> p/compile
+
+# A body edit recompiles L.scala alone. L.A, the ancestor of L.B nested in the same object, is a
+# class of this subproject in both compiles, though only the second can name its classfile, so
+# L.B's API does not move and U, which reads only L.B, does not recompile.
+$ copy-file changes/L.scala p/L.scala
+> p/compile
+> p/checkRecompilations 1 p.L p.L$.A p.L$.B
+> p/checkIterations 2
-- 
2.56.0


#!/usr/bin/env python3
"""Turn a lockstep run into the campaign dashboard's datasets.

    lockstep-dash RUN_DIR OUT_DIR [--edits EDITS] [--name NAME] [--cells-total N]

Reads RUN_DIR (from `lockstep`: campaign.json and steps.jsonl) and writes OUT_DIR/{campaign,cells,
steps,phases,cycles,edits}.json, one JSON array each, in the shapes the dashboard reads.

A cell's name is its dashboard id, `s2|s3`-`released|integration`-`released|perf|merkle|merklenames`: build,
compiler (base or integration) and Zinc (1.12.x, + fixes, + fixes + Merkle). Step 1 is the clean
build that starts each cell; steps 2.. are lockstep's rounds in order, ending with the clean build
in the warm JVM.
"""

import argparse
import ast
import datetime
import json
import re
from pathlib import Path

BUILDS = {"s2": "scala/scala", "s3": "scala/scala3"}
LINES = {"s2": "2.13", "s3": "3"}
# Other projects' exports, by the checkout they came from; their s2 and s3 cells are the two Scala lines.
CORPORA = {"pekko": "apache/pekko", "cats": "typelevel/cats", "shapeless": "milessabin/shapeless",
           "scala-steward": "scala-steward-org/scala-steward"}
COMPILERS = {"released": "base", "integration": "integration"}
ZINCS = {"released": ("1.12.x", "name hashing"), "perf": ("1.12.x + fixes", "name hashing"),
         "merkle": ("1.12.x + fixes + Merkle", "Merkle"),
         # the Merkle build with hashing left at its default
         "merklenames": ("1.12.x + fixes + Merkle", "name hashing")}
# Scala 2 and Scala 3 phases by the dashboard's groups; every other phase is a transform. Scala 3
# expands inline methods and macros in phases after typer, which scalac does in typer, so those
# count as typer. A Scala 3 MegaPhase{a, b, ...} goes in the group all its phases share.
GROUPS = {
    "frontend": {"<init phase>", "parser", "namer", "packageobjects"},
    "typer": {"typer", "inlining", "postInlining", "staging", "splicing", "pickleQuotes"},
    "checks": {"superaccessors", "extmethods", "pickler", "refchecks", "posttyper", "inlinedPositions",
               "Winfer-union", "checkUnusedPostTyper", "checkShadowing", "checkUnusedPostInlining",
               "checkUnusedPostPatMat", "checkInlineTraits", "initChecker", "preRecheck", "recheck",
               "setupCC", "cc"},
    "api": {"xsbt-api", "sbt-api"},
    "deps": {"xsbt-dependency", "xsbt-analyzer", "sbt-deps"},
    "backend": {"jvm", "genBCode", "genSJSIR"},
}
INVALIDATE = ["initialChanges", "invalidateInitial", "detectAPIChanges", "invalidate", "prune", "merge", "analysis"]


def corpus_name(build, line_key):
    """The project a cell's build was exported from, or scala/scala or scala/scala3 by its Scala line."""
    export = Path(build) / "export.json" if build else None
    if export and export.exists():
        repo = Path(json.loads(export.read_text())["from"]).name
        if repo in CORPORA:
            return CORPORA[repo]
    return BUILDS[line_key]


def mini_phases(phase):
    """The phases a Scala 3 MegaPhase runs together, or just `phase`."""
    if phase.startswith("MegaPhase{") and phase.endswith("}"):
        return phase[len("MegaPhase{"):-1].split(", ")
    return [phase]


def group(phase):
    gs = {next((g for g, ps in GROUPS.items() if p in ps), "transforms") for p in mini_phases(phase)}
    return gs.pop() if len(gs) == 1 else "transforms"


def phase_label(phase):
    """A MegaPhase by its first and last phases, as Scala 3 shows it."""
    ps = mini_phases(phase)
    return ps[0] if len(ps) == 1 else f"{{{ps[0]}…{ps[-1]}}}"


def activity(log):
    """What lockstep is doing now, from its log: a sentence, and the cell and step compiling, if any."""
    if not log or not log.exists():
        return None, None, None
    lines = [l.removeprefix("[lockstep] ") for l in log.read_text().splitlines() if l.startswith("[lockstep]")]
    text, cell, step, order, finished, rnd = None, None, None, [], set(), 0
    for l in lines:
        m = re.match(r"round (\d+): (\S+) rep (\d+), order (\[.*\])$", l)
        if m:
            rnd, order, finished = int(m.group(1)), ast.literal_eval(m.group(4)), set()
            text = f"step {rnd + 1}, {m.group(2)}"
            continue
        m = re.match(r"  (\S+): [0-9.]+s$", l)
        if m:
            finished.add(m.group(1))
            continue
        m = re.match(r"(\S+): (building|clean build and warm-up)", l)
        if m:
            cell, step, order = m.group(1), 1, []
            text = f"preparing {m.group(1)}: {'compiling the cell' if m.group(2) == 'building' else 'clean build and warm-up'}"
            continue
        if l.startswith("done"):
            return "finished", None, None
    if order:
        cell = next((c for c in order if c not in finished), None)
        step = rnd + 1
    return text, cell, step


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("run_dir", type=Path)
    ap.add_argument("out_dir", type=Path)
    ap.add_argument("--edits", type=Path, help="the edits TSV, if not the one campaign.json names")
    ap.add_argument("--name")
    ap.add_argument("--cells-total", type=int, help="cells in the whole campaign, when this run is part of it")
    ap.add_argument("--release", default="2.13.18",
                    help="the Scala release a cell without a locally built compiler runs (scripted's 2.13.x label)")
    ap.add_argument("--release3", default="3.3.7",
                    help="the Scala 3 release an s3 cell without a locally built compiler runs (scripted's 3.x label)")
    ap.add_argument("--log", type=Path, help="lockstep's log, whose last line says what it is doing now")
    a = ap.parse_args()
    camp = json.loads((a.run_dir / "campaign.json").read_text())
    lines = [json.loads(l) for l in (a.run_dir / "steps.jsonl").read_text().splitlines() if l.strip()]
    edits_tsv = a.edits or Path(camp["edits"])
    files = {}
    for l in edits_tsv.read_text().splitlines():
        if l.strip() and not l.startswith("#"):
            name, file = l.split("\t")[:2]
            files.setdefault(name, file)
    only = camp["options"].get("only")
    reps = camp["options"]["reps"]
    # The steps every cell runs, as IncBench orders them: the clean build, each edit and its revert
    # per repetition, then the clean build in the warm JVM per repetition.
    plan = [("clean", None)]
    for name in files:
        if not only or re.search(only, name):
            for _ in range(reps):
                plan += [(name, files[name]), (name + "-revert", files[name])]
    plan += [("clean-build", None)] * reps

    cells, steps, phases, cycles = [], [], [], []
    names = [c["name"] for c in camp["cells"]]
    local = {c["name"]: c.get("scala") for c in camp["cells"]}
    build_of = {c["name"]: c.get("build") or camp.get("build") for c in camp["cells"]}
    for n in names:
        b, comp, z = n.split("-")
        # A cell on a locally built compiler is base or integration; otherwise it runs the release.
        release = a.release3 if b == "s3" else a.release
        label = COMPILERS[comp] if local.get(n) else release
        cells.append(dict(cell=n, corpus=corpus_name(build_of[n], b), line=LINES[b], compiler=label, compilerVersion=local.get(n) or release,
                          zinc=ZINCS[z][0], algo=ZINCS[z][1], compilerKey=comp, zincKey=z))
    corpus_of = {c["cell"]: c["corpus"] for c in cells}

    timed = [r for r in lines if r["step"] not in ("warmup", "verify-base") and not r["step"].endswith("-reset")]
    verdicts = {}
    for r in lines:
        if r["step"].endswith("-reset"):
            verdicts[(r["cell"], r["round"])] = "reset after " + r.get("verify", "?")
    edit_rows = {}
    for r in timed:
        step = r["round"] + 1
        name = r["step"]
        kind = "clean" if name in ("clean", "clean-build") else "revert" if name.endswith("-revert") else "edit"
        desc = {"clean": "Clean build in a fresh JVM", "clean-build": "Clean build in the warm JVM"}.get(name, name)
        target = files.get(name.removesuffix("-revert"), "—")
        corpus = corpus_of[r["cell"]]
        edit_rows[(corpus, step)] = dict(corpus=corpus, step=step, kind=kind, target=target, edit=desc)
        ps = r.get("scalacPhases", [])
        zinc = r.get("zinc", {})
        # A step that failed to compile has no timing; it shows as failed, with its errors.
        failed = "wallMillis" not in r
        wall = r.get("wallMillis", 0)
        compile_ms = sum(p["millis"] for p in ps)
        zinc_ms = max(0, wall - compile_ms)
        analysis_io = zinc.get("analysisWrite", 0)
        invalidate = sum(zinc.get(k, 0) for k in INVALIDATE)
        setup = max(0, zinc_ms - analysis_io - invalidate)
        cyc = [c for run in r.get("zincRuns", []) for c in run["cycles"]]
        prev_changes = None
        for i, (run, c) in enumerate(((run, c) for run in r.get("zincRuns", []) for c in run["cycles"]), 1):
            if c["cycle"] == 1:
                reason = "all sources" if kind == "clean" else f"{run['module']}: the edited and changed sources"
            else:
                ch = prev_changes or []
                ex = ", ".join(f"{x['class'].rsplit('.', 1)[-1]} ({', '.join(x['names'][:4])}{'…' if x['namesTotal'] > 4 else ''})"
                               for x in ch[:3])
                reason = f"{run['module']}: {len(ch)} API change{'s' if len(ch) != 1 else ''} in cycle {c['cycle'] - 1}" + (f", e.g. {ex}" if ex else "")
            cycles.append(dict(cell=r["cell"], step=step, cycle=i, sources=c["sources"], classes=c["recompiledClasses"],
                               reason=reason, module=run["module"], compileMs=c["compileMillis"]))
            prev_changes = c["changes"]
        steps.append(dict(cell=r["cell"], corpus=corpus, step=step, kind=kind, target=target, edit=desc,
                          status="failed" if failed else "done", order=r["order"], sources=sum(c["sources"] for c in cyc),
                          classes=r.get("recompiled"), cycles=len(cyc), start=r.get("startSec", 0),
                          wallMs=wall, compileMs=compile_ms, zincMs=zinc_ms, wallMinMs=wall, wallMaxMs=wall,
                          verify=verdicts.get((r["cell"], r["round"]), r.get("verify"))))
        by_group = {}
        for p in ps:
            g = by_group.setdefault(group(p["phase"]), {"ms": 0, "alloc": 0, "names": []})
            g["ms"] += p["millis"]
            g["alloc"] += p["allocatedBytes"]
            g["names"].append(phase_label(p["phase"]))
        for g, v in by_group.items():
            phases.append(dict(cell=r["cell"], step=step, group=g, phase=" + ".join(v["names"]), ms=v["ms"], allocBytes=v["alloc"]))
        for g, label, ms in [("zinc-invalidate", "Invalidation", invalidate), ("zinc-analysis", "Analysis write", analysis_io),
                             ("zinc-setup", "Setup and the rest", setup)]:
            phases.append(dict(cell=r["cell"], step=step, group=g, phase=label, ms=round(ms)))

    per_cell = len(plan)
    done = len(steps)
    have = {(s["cell"], s["step"]) for s in steps}
    for corpus in {c["corpus"] for c in cells}:
        for k, (name, target) in enumerate(plan, 1):
            kind = "clean" if name in ("clean", "clean-build") else "revert" if name.endswith("-revert") else "edit"
            desc = {"clean": "Clean build in a fresh JVM", "clean-build": "Clean build in the warm JVM"}.get(name, name)
            edit_rows.setdefault((corpus, k), dict(corpus=corpus, step=k, kind=kind, target=target or "—", edit=desc))
    for c in cells:
        for k, (name, target) in enumerate(plan, 1):
            if (c["cell"], k) not in have:
                e = edit_rows[(c["corpus"], k)]
                steps.append(dict(cell=c["cell"], corpus=c["corpus"], step=k, kind=e["kind"], target=e["target"],
                                  edit=e["edit"], status="queued", order=None, sources=None, classes=None, cycles=None))
    act, act_cell, act_step = activity(a.log) if a.log else (None, None, None)
    for s in steps:
        if s["status"] == "queued" and s["cell"] == act_cell and s["step"] == act_step:
            s["status"] = "running"
    finished = [k for k in range(1, per_cell + 1) if all((c["cell"], k) in have for c in cells)]
    current = next((k for k in range(1, per_cell + 1) if k not in finished), per_cell)
    ends = [s["start"] + s["wallMs"] / 1000 for s in steps if s["status"] == "done"]
    last = max(ends) if ends else 0
    started = datetime.datetime.fromisoformat(camp["start"])
    progress = {}
    pf = a.run_dir / "progress.json"
    if pf.exists():
        progress = json.loads(pf.read_text())
    running = progress.get("next") is not None or len(finished) < per_cell
    elapsed = (datetime.datetime.now(started.tzinfo) - started).total_seconds() if running else last
    rounds_done = max(len(finished) - 1, 0)
    per_round = (elapsed - min((s["start"] for s in steps if s["status"] == "done" and s["step"] == 2), default=elapsed)) / rounds_done if rounds_done else 0
    eta = per_round * (per_cell - len(finished)) if running else 0
    steps.sort(key=lambda s: (s["cell"], s["step"]))
    campaign = [dict(name=a.name or Path(a.run_dir).name, started=camp["start"], reps=camp["options"]["reps"],
                     cells=a.cells_total or len(names), stepsPerCell=per_cell, stepsTotal=per_cell * (a.cells_total or len(names)),
                     stepsDone=done, currentStep=current, elapsedSec=round(elapsed), etaSec=round(eta),
                     machine=camp.get("machine", "—"), sample=False, activity=act if running else "finished", activeCell=act_cell if running else None,
                     commits={c["name"]: c["commit"][:10] for c in camp["cells"]})]
    a.out_dir.mkdir(parents=True, exist_ok=True)
    out = dict(campaign=campaign, cells=cells, steps=steps, phases=phases, cycles=cycles,
               edits=sorted(edit_rows.values(), key=lambda e: (e["corpus"], e["step"])))
    for k, v in out.items():
        (a.out_dir / f"{k}.json").write_text(json.dumps(v) + "\n")
        print(f"{k}: {len(v)} rows")


if __name__ == "__main__":
    main()

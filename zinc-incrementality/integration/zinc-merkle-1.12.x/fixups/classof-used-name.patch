+
+object W {
+  class Foo
+}
diff --git a/zinc/src/sbt-test/source-dependencies/classof-used-name/changes/W.scala b/zinc/src/sbt-test/source-dependencies/classof-used-name/changes/W.scala
new file mode 100644
index 000000000..6f3ea40fb
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/classof-used-name/changes/W.scala
@@ -0,0 +1,3 @@
+package a
+
+object W
diff --git a/zinc/src/sbt-test/source-dependencies/classof-used-name/test b/zinc/src/sbt-test/source-dependencies/classof-used-name/test
new file mode 100644
index 000000000..07842a821
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/classof-used-name/test
@@ -0,0 +1,8 @@
+# Client names W.Foo only through a classOf literal.
+> compile
+
+# W loses Foo: a clean build fails. The bridge records the dependency on W.Foo, and the name Foo of
+# W changes; the name filter keeps Client only if ExtractUsedNames registers the names of the type
+# of a classOf literal.
+$ copy-file changes/W.scala W.scala
+-> compile

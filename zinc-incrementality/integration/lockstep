#!/usr/bin/env python3
"""Run IncBench cells in lockstep, one compile at a time.

    lockstep OUT_DIR --build BUILD --edits EDITS --cell NAME=ZINC_CHECKOUT... [options]

Each cell is one Zinc checkout running `IncBench --serve` on its own copy of a frozen build (from
`export-build`). Cells start one at a time: each loads the build, compiles it clean and warms up,
then waits. For each step, the cells run it in a shuffled order, one at a time, so no two compiles
compete for the machine; after the last of them, the barrier writes the results and runs
`--on-step`. Every cell must be waiting for the same step, or the campaign stops.

OUT_DIR gets:

    campaign.json            the cells, their commits and the options
    steps.jsonl              IncBench's JSON lines, each with its cell, round and order in the round
    progress.json            the last finished round and the step that comes next
    cells/<name>/build       the cell's copy of the build, and IncBench's siblings of it
    cells/<name>/incbench.log  what IncBench wrote that isn't a result
"""

import argparse
import datetime
import hashlib
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

MAIN = "sbt.internal.inc.bench.IncBench"


def log(msg):
    print(f"[lockstep] {msg}", file=sys.stderr, flush=True)


def git(checkout, *args):
    return subprocess.run(["git", *args], cwd=checkout, text=True, capture_output=True, check=True).stdout.strip()


def test_classpath(checkout, out):
    """
    Compiles the checkout's bridge and IncBench, and returns IncBench's classpath and the 2.13
    bridge's dependency classpath.
    """
    r = subprocess.run(
        ["sbt", "--batch", "--no-server", "--color=false",
         "compilerBridge2_13/compile", "zincScripted/Test/compile", "export zincScripted/Test/fullClasspath",
         "export compilerBridge2_13/Compile/dependencyClasspath",
         'eval println("@@bridge-options@@")', "print compilerBridge2_13/Compile/scalacOptions",
         'eval println("@@end@@")'],
        cwd=checkout, text=True, capture_output=True)
    out.write_text(r.stdout + r.stderr)
    if r.returncode != 0:
        sys.exit(f"{checkout}: sbt failed, see {out}")
    lines = r.stdout.splitlines()
    test_cp, bridge_cp = [l for l in lines if l.startswith("/")][-2:]
    opts = lines[lines.index("@@bridge-options@@") + 1:lines.index("@@end@@")]
    bridge_opts = [l.removeprefix("* ").strip() for l in opts if l.strip() and not l.startswith("[")]
    return test_cp, (bridge_cp, bridge_opts)


BRIDGE_SOURCES = ["scala", "scala-2", "scala-2.13", "scala_2.13", "scalajvm", "scalajvm-2.13"]


def compile_bridge(checkout, version, jars, bridge, cache):
    """
    The checkout's 2.13 compiler bridge compiled by a locally built Scala, whose binary interface
    may differ from the release the checkout's own bridge is compiled against, with the scalac
    options sbt compiles it with (the optimizer's among them). Cached by the checkout's commit,
    the Scala version and the options.
    """
    bridge_cp, bridge_opts = bridge
    key = hashlib.sha1(" ".join(bridge_opts).encode()).hexdigest()[:8]
    out = cache / f"{git(checkout, 'rev-parse', '--short=10', 'HEAD')}-{version}-{key}"
    if (out / ".done").exists():
        return out
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    src = checkout / "internal/compiler-bridge/src/main"
    sources = [str(f) for d in BRIDGE_SOURCES if (src / d).is_dir() for f in sorted((src / d).rglob("*.scala"))]
    # The bridge's dependencies without the release's own Scala jars, which the local build replaces.
    deps = [p for p in bridge_cp.split(":") if not re.search(r"/scala-(library|reflect|compiler)-[^/]*\.jar$", p)]
    r = subprocess.run(["java", "-Xss4m", "-cp", jars, "scala.tools.nsc.Main", *bridge_opts, "-nowarn", "-d", str(out),
                        "-classpath", ":".join(deps + [jars]), *sources], text=True, capture_output=True)
    if r.returncode != 0:
        sys.exit(f"compiling {checkout}'s bridge with Scala {version} failed:\n{r.stdout[-3000:]}{r.stderr[-3000:]}")
    shutil.copytree(src / "resources", out, dirs_exist_ok=True)
    (out / ".done").write_text("")
    return out


def copy_build(src, dst):
    if dst.exists():
        shutil.rmtree(dst)
    shutil.copytree(src, dst, ignore=shutil.ignore_patterns("target"))


class Cell:
    def __init__(self, name, checkout, dir):
        self.name, self.checkout, self.dir = name, checkout, dir
        self.proc = None
        self.ready = None

    def start(self, classpath, jvm_opts, args, env):
        self.log = open(self.dir / "incbench.log", "a")
        self.proc = subprocess.Popen(
            ["java", *jvm_opts, "-cp", classpath, MAIN, *args],
            cwd=self.dir, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.log, text=True, bufsize=1,
            env={**os.environ, **env})

    def results(self):
        """IncBench's results until it waits for the next step, which is then `ready`."""
        out = []
        for line in self.proc.stdout:
            s = line.strip()
            if s.startswith("[info] "):
                s = s[len("[info] "):]
            obj = None
            if s.startswith("{"):
                try:
                    obj = json.loads(s)
                except ValueError:
                    pass
            if obj is None:
                self.log.write(line)
            elif "ready" in obj:
                self.ready = (obj["ready"], obj["rep"])
                return out
            else:
                out.append(obj)
        self.ready = None
        self.proc.wait()
        return out

    def step(self):
        self.proc.stdin.write("step\n")
        self.proc.stdin.flush()
        return self.results()

    def shutdown(self):
        if self.proc and self.proc.poll() is None:
            self.proc.stdin.write("shutdown\n")
            self.proc.stdin.flush()
            self.proc.wait()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("out_dir", type=Path)
    ap.add_argument("--build", type=Path, required=True)
    ap.add_argument("--edits", type=Path, required=True)
    ap.add_argument("--cell", action="append", required=True, help="NAME=ZINC_CHECKOUT")
    ap.add_argument("--cell-option", action="append", default=[],
                    help="NAME=KEY=VALUE, an incOptions entry for that cell only, after the common --inc-options "
                         "(e.g. hashing=merkle for a Merkle cell)")
    ap.add_argument("--cell-build", action="append", default=[],
                    help="NAME=BUILD, a frozen build for that cell instead of --build: the same edits on another "
                         "export, such as the Scala 3 build of a cross-built project")
    ap.add_argument("--cell-scala", action="append", default=[],
                    help="NAME=VERSION:JARS, a locally built Scala 2.13 for that cell: its version and its library, "
                         "reflect and compiler jars separated by ':' (scripted's 2.13.local bridge label)")
    ap.add_argument("--cell-scala3", action="append", default=[],
                    help="NAME=VERSION:BRIDGE:JARS, a Scala 3 release or local build for that cell: its version, its "
                         "scala3-sbt-bridge jar and its compiler and library jars separated by ':' (scripted's 3.local label)")
    ap.add_argument("--reps", type=int, default=1)
    ap.add_argument("--warmup", type=int, default=2)
    ap.add_argument("--verify", action="store_true")
    # scalac's profiler costs little, and without it the dashboard has no phases or allocation.
    ap.add_argument("--profile", action=argparse.BooleanOptionalAction, default=True)
    ap.add_argument("--only")
    # sbt's defaults where scripted's differ. recompileOnMacroDef is sbt's default true, stated so the
    # generated incOptions.properties shows it: false makes builds that define macros or use @inline
    # unsound. Only scala/scala runs with false (--cell-option NAME=recompileOnMacroDef=false), where
    # the point is the macro fast-track fix (rz#73), which only the Zincs that carry it get credit for.
    ap.add_argument("--inc-option", action="append",
                    default=["pipelining=false", "recompileAllFraction=0.5", "recompileOnMacroDef=true"])
    ap.add_argument("--jvm-opt", action="append")
    ap.add_argument("--analysis-compression", type=int,
                    help="the deflate level, 0 to 9, every cell's analysis store compresses at (sbt.analysis.compression)")
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--bridge-cache", type=Path, default=Path.home() / "code/.integration/bridges",
                    help="where bridges compiled by a locally built Scala are kept")
    ap.add_argument("--on-step", help="a shell command run after each round's barrier")
    a = ap.parse_args()
    jvm_opts = a.jvm_opt or ["-Xmx4g", "-Xss4m"]
    if a.analysis_compression is not None:
        jvm_opts = jvm_opts + [f"-Dsbt.analysis.compression={a.analysis_compression}"]
    out = a.out_dir.resolve()
    (out / "cells").mkdir(parents=True, exist_ok=True)
    cells = []
    for spec in a.cell:
        name, checkout = spec.split("=", 1)
        checkout = Path(checkout).expanduser().resolve()
        d = out / "cells" / name
        d.mkdir(parents=True, exist_ok=True)
        cells.append(Cell(name, checkout, d))
    scala3 = {}
    for spec in a.cell_scala3:
        name, rest = spec.split("=", 1)
        version, bridge, jars = rest.split(":", 2)
        scala3[name] = (version, bridge, jars)
    builds = {c.name: a.build.resolve() for c in cells}
    for spec in a.cell_build:
        name, b = spec.split("=", 1)
        builds[name] = Path(b).expanduser().resolve()
    scala = {}
    for spec in a.cell_scala:
        name, rest = spec.split("=", 1)
        version, jars = rest.split(":", 1)
        scala[name] = (version, jars)

    # A sleeping laptop inflates whichever compile spans the sleep; macOS's caffeinate holds off idle and system
    # sleep for as long as this process lives.
    if shutil.which("caffeinate"):
        subprocess.Popen(["caffeinate", "-ims", "-w", str(os.getpid())])
    start = time.time()
    campaign = {
        "start": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "build": str(a.build.resolve()), "edits": str(a.edits.resolve()),
        "options": {k: v for k, v in vars(a).items() if k not in ("out_dir", "build", "edits", "cell", "cell_build", "cell_scala3", "on_step")},
        "jvmOptions": jvm_opts,
        "machine": machine(),
        "cells": [{"name": c.name, "checkout": str(c.checkout), "commit": git(c.checkout, "rev-parse", "HEAD"),
                   "branch": git(c.checkout, "rev-parse", "--abbrev-ref", "HEAD"),
                   "scala": scala[c.name][0] if c.name in scala else None, "build": str(builds[c.name]),
                   "scala3": scala3[c.name][0] if c.name in scala3 else None,
                   "options": [s.split("=", 1)[1] for s in a.cell_option if s.split("=", 1)[0] == c.name]}
                  for c in cells],
    }
    (out / "campaign.json").write_text(json.dumps(campaign, indent=2, default=str) + "\n")
    steps = open(out / "steps.jsonl", "w")

    def record(cell, round, order, results, started):
        for r in results:
            steps.write(json.dumps({"cell": cell.name, "round": round, "order": order,
                                    "startSec": round_(started - start), **r}) + "\n")
        steps.flush()

    try:
        for c in cells:
            log(f"{c.name}: building {c.checkout}")
            cp, bridge_cp = test_classpath(c.checkout, c.dir / "sbt.log")
            build = c.dir / "build"
            copy_build(builds[c.name], build)
            env = {}
            if c.name in scala3:
                version, bridge, jars = scala3[c.name]
                env = {"ZINC_SCRIPTED_SCALA3_VERSION": version, "ZINC_SCRIPTED_SCALA3_JARS": jars,
                       "ZINC_SCRIPTED_SCALA3_BRIDGE": bridge}
                bj = build / "build.json"
                b = json.loads(bj.read_text())
                for p in b["projects"]:
                    p["scalaVersion"] = "3.local"
                bj.write_text(json.dumps(b, indent=2) + "\n")
            if c.name in scala:
                version, jars = scala[c.name]
                log(f"{c.name}: compiling the bridge with Scala {version}")
                bridge = compile_bridge(c.checkout, version, jars, bridge_cp, a.bridge_cache)
                env = {"ZINC_SCRIPTED_SCALA213_VERSION": version, "ZINC_SCRIPTED_SCALA213_JARS": jars,
                       "ZINC_SCRIPTED_SCALA213_BRIDGE": str(bridge)}
                bj = build / "build.json"
                b = json.loads(bj.read_text())
                for p in b["projects"]:
                    p["scalaVersion"] = "2.13.local"
                bj.write_text(json.dumps(b, indent=2) + "\n")
            args = ["--build", str(build), "--edits", str(a.edits.resolve()), "--reps", str(a.reps),
                    "--warmup", str(a.warmup), "--label", c.name, "--serve", "--out", str(c.dir / "incbench.jsonl")]
            args += [x for kv in a.inc_option for x in ("--inc-option", kv)]
            args += [x for spec in a.cell_option if spec.split("=", 1)[0] == c.name
                     for x in ("--inc-option", spec.split("=", 1)[1])]
            args += (["--verify"] if a.verify else []) + (["--profile"] if a.profile else [])
            args += (["--only", a.only] if a.only else [])
            log(f"{c.name}: clean build and warm-up")
            t = time.time()
            c.start(cp, jvm_opts, args, env)
            record(c, 0, 0, c.results(), t)
            log(f"{c.name}: ready for {c.ready}")
        rng = random.Random(a.seed)
        round = 0
        while any(c.ready for c in cells):
            readies = {c.ready for c in cells}
            if len(readies) != 1:
                sys.exit("cells are out of step: " + ", ".join(f"{c.name} at {c.ready}" for c in cells))
            round += 1
            (name, rep), = readies
            order = cells[:]
            rng.shuffle(order)
            log(f"round {round}: {name} rep {rep}, order {[c.name for c in order]}")
            for i, c in enumerate(order):
                t = time.time()
                record(c, round, i + 1, c.step(), t)
                log(f"  {c.name}: {time.time() - t:.1f}s")
            nxt = next(iter({c.ready for c in cells}))
            (out / "progress.json").write_text(json.dumps({
                "round": round, "step": name, "rep": rep, "next": nxt and {"step": nxt[0], "rep": nxt[1]},
                "elapsedSeconds": round_(time.time() - start)}) + "\n")
            if a.on_step:
                subprocess.run(a.on_step, shell=True, env={**os.environ, "LOCKSTEP_DIR": str(out), "LOCKSTEP_ROUND": str(round)})
        log(f"done after {round} rounds in {time.time() - start:.0f}s")
    finally:
        for c in cells:
            c.shutdown()


def machine():
    def sysctl(k):
        r = subprocess.run(["sysctl", "-n", k], text=True, capture_output=True)
        return r.stdout.strip()
    cpu, mem = sysctl("machdep.cpu.brand_string"), sysctl("hw.memsize")
    java = subprocess.run(["java", "-XshowSettings:properties", "-version"], text=True, capture_output=True).stderr
    jv = next((l.split("=")[1].strip() for l in java.splitlines() if "java.version =" in l), "?")
    return f"{cpu or 'unknown CPU'}, {int(mem) // 2**30 if mem else '?'} GB, JDK {jv}"


def round_(x):
    return round(x, 1)


if __name__ == "__main__":
    main()

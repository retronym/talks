#!/usr/bin/env python3
"""Summarise a lockstep run for anomaly hunting.

    lockstep-summary OUT_DIR [--changes N]

One block per step: for each cell its verify verdict, sources recompiled per module and cycle,
wall time, scalac's time (the sum of its phases), Zinc's own time (wall minus scalac) with its
largest parts, and the API changes each cycle reported, as class: names. Steps whose cells
disagree on what they recompiled, or whose verdict is not `same`/`signature`, are flagged.
"""

import argparse
import json
from collections import defaultdict
from pathlib import Path

OK = {"same", "signature"}


def cycles(r):
    out = []
    for run in r.get("zincRuns", []):
        cs = run.get("cycles", [])
        if cs:
            out.append(f"{run['module']}:" + "+".join(str(c["sources"]) for c in cs))
    return " ".join(out) or "-"


def changes(r, n):
    out = []
    for run in r.get("zincRuns", []):
        ext = run.get("externalChanges") or []
        if ext:
            out.append(f"    {run['module']} external: " + "; ".join(
                f"{c.get('class')}: {','.join(c.get('names', [])[:n])}" for c in ext[:n]))
        for c in run.get("cycles", []):
            ch = c.get("changes", [])
            if not ch:
                continue
            shown = "; ".join(
                f"{x['class']} [{x['reason'].split('.')[0]}]: {','.join(x.get('names', [])[:n])}"
                + (f" (+{x['namesTotal'] - n})" if x.get("namesTotal", 0) > n else "")
                for x in ch[:n])
            more = f" ... +{len(ch) - n} classes" if len(ch) > n else ""
            out.append(f"    {run['module']} cycle {c['cycle']} ({c['sources']} src, "
                       f"{c.get('invalidatedByPackageObjects', 0)} by pkgobj) -> {c.get('nextInvalidations')}: {shown}{more}")
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("out_dir", type=Path)
    ap.add_argument("--changes", type=int, default=4)
    a = ap.parse_args()
    by_step = defaultdict(dict)
    order = []
    for line in open(a.out_dir / "steps.jsonl"):
        r = json.loads(line)
        if r.get("step") in ("warmup", "clean", "verify-base") or "wallMillis" not in r or isinstance(r["wallMillis"], list):
            if r.get("step") == "clean" or r.get("step") == "verify-base":
                print(f"{r['cell']:22} {r['step']}: {r.get('verify', '')} wall {r.get('wallMillis')}")
            continue
        s = r["step"]
        if s not in by_step:
            order.append(s)
        by_step[s][r["cell"]] = r
    for s in order:
        cells = by_step[s]
        recomp = {c: r.get("recompiled") for c, r in cells.items()}
        flags = []
        if any(r.get("verify") not in OK for r in cells.values() if "verify" in r):
            flags.append("VERIFY")
        vals = [v for v in recomp.values() if v is not None]
        if vals and max(vals) > 2 * max(1, min(vals)) and max(vals) - min(vals) > 3:
            flags.append("DISAGREE")
        print(f"\n== {s} {' '.join(flags)}")
        for c in sorted(cells):
            r = cells[c]
            scalac = sum(p["millis"] for p in r.get("scalacPhases", []))
            z = r.get("zinc", {})
            wall = r["wallMillis"]
            parts = sorted(((k, v) for k, v in z.items() if k not in ("zincCall", "compile")), key=lambda kv: -kv[1])[:3]
            print(f"  {c:22} {r.get('verify', '-'):14} rec {r.get('recompiled'):>4} cyc {cycles(r):28} "
                  f"wall {wall:>6} scalac {scalac:>6} zinc {wall - scalac:>6} "
                  + " ".join(f"{k}={v:.0f}" for k, v in parts))
            if r.get("diff"):
                print(f"    diff: {r['diff'][:6]}")
        for c in sorted(cells):
            ch = changes(cells[c], a.changes)
            if ch:
                print(f"  [{c}]")
                print("\n".join(ch))


if __name__ == "__main__":
    main()

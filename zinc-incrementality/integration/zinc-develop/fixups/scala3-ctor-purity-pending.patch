diff --git a/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/Counter.scala b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/Counter.scala
new file mode 100644
index 000000000..ac4002881
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/Counter.scala
@@ -0,0 +1,3 @@
+object Counter {
+  var n = 0
+}
diff --git a/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/X.scala b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/X.scala
new file mode 100644
index 000000000..49ad72e47
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/p/X.scala
@@ -0,0 +1,4 @@
+object X {
+  inline def ignore(x: Any): Unit = ()
+  def main(args: Array[String]): Unit = ()
+}
diff --git a/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/pending b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/pending
new file mode 100644
index 000000000..bc64a0421
--- /dev/null
+++ b/zinc/src/sbt-test/source-dependencies/scala3-ctor-purity/pending
@@ -0,0 +1,14 @@
+# Pending until the Scala 3 bridge folds constructor purity into <init>'s name hash (PLAN-merkle-bughunt.md finding 7,
+# ANALYSIS-finding7-ctor-purity.md): Namer marks a constructor STABLE when no base class has initializers, the
+# pickler writes the flag and the unpickler reads it back unchanged, and adding an initializer to A changes nothing
+# in its API.
+> p/compile
+
+# A gains an initializer; B, whose constructor was STABLE, is not recompiled
+$ copy-file changes/A.scala p/A.scala
+> p/compile
+
+# A client compiled now must still run A's initializer when it constructs a B
+$ copy-file changes/X.scala p/X.scala
+> p/compile
+> p/run
-- 

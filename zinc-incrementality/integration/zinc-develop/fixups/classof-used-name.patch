 .../src/main/scala/xsbt/ExtractUsedNames.scala         |  1 +
 .../classof-added-java-class-ambiguous/Client.scala    |  8 ++++++++
 .../changes/Foo.java                                   |  3 +++
 .../incOptions.properties                              |  1 +

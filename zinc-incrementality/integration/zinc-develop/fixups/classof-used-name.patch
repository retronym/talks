diff --git a/internal/compiler-bridge-test/src/test/scala/sbt/internal/inc/ExtractUsedNamesSpecification.scala b/internal/compiler-bridge-test/src/test/scala/sbt/internal/inc/ExtractUsedNamesSpecification.scala
index ec83fbc14..21bf5a349 100644
--- a/internal/compiler-bridge-test/src/test/scala/sbt/internal/inc/ExtractUsedNamesSpecification.scala
+++ b/internal/compiler-bridge-test/src/test/scala/sbt/internal/inc/ExtractUsedNamesSpecification.scala
@@ -84,6 +84,16 @@ class ExtractUsedNamesSpecification
     assert(usedNames("b.X") === expectedNames)
   }
 
+  it should "extract the names of the type of a classOf literal" in {
+    val srcA = "package a { object W { class Foo[T] }; class Bar }"
+    val srcB = """|package b
+                  |import a.W._
+                  |class B { val c: Any = classOf[Foo[a.Bar]] }""".stripMargin
+    val usedNames = extractUsedNamesFromSrc(srcA, srcB)
+    assert(usedNames("b.B").contains("Foo"))
+    assert(usedNames("b.B").contains("Bar"))
+  }
+
   // test for https://github.com/gkossakowski/sbt/issues/5
   it should "extract symbolic names" in {
     val srcA = """|class A {
diff --git a/internal/compiler-bridge/src/main/scala/xsbt/ExtractUsedNames.scala b/internal/compiler-bridge/src/main/scala/xsbt/ExtractUsedNames.scala
index 7ff97c355..a15e14228 100644
--- a/internal/compiler-bridge/src/main/scala/xsbt/ExtractUsedNames.scala
+++ b/internal/compiler-bridge/src/main/scala/xsbt/ExtractUsedNames.scala
@@ -308,6 +308,7 @@ class ExtractUsedNames[GlobalType <: CallbackGlobal](val global: GlobalType)
 
         addTypeNames(t.tpe)
       case l: Literal =>
+        if (l.value.tag == ClazzTag) addTypeNames(l.value.typeValue)
         processOriginalTreeAttachment(l)(traverse)
       case _ =>
     }
